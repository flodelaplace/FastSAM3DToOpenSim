# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# SSH/AWS keys — never commit
*.pem

# Ignore large model files but keep configs
checkpoints/**/*.ckpt
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.engine
checkpoints/**/*.onnx
checkpoints/**/*.trt
checkpoints/**/*.plan
checkpoints/**/*_trt/

/output
output_*/
output_opensim/
output_video/
outputs/
videos/

# IDE / editor
.claude/
.idea/
.vscode/

# Template backups + versioned snapshots (keep locally, don't commit)
assets/*_backup.osim
assets/flodelaplace_mocap_v*.osim

# Generated viz / tool outputs
tools/anatomical_landmarks.html
tools/anatomical_landmarks.json
tools/mhr_127_joints.csv
tools/mhr_127_joints.html
tools/mhr_vertices.csv
tools/rajagopal_markers_viz.html
tools/rajagopal_markers_viz.json

# OpenSim logs + stray
assets/opensim.log
*.log

# Per-clip retargeted avatar GLB outputs (intermediate POCs kept locally only)
assets/avatars/*pocA*.glb
assets/avatars/avatar_*_animated_*.glb